cat > .gitignore <<'EOF'
# Python environments and caches
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/

# Secrets
.env
.env.*
!.env.example

# Models and generated analysis data
models/
data/
runs/
*.pt
*.onnx

# Videos and archives
*.mp4
*.avi
*.mov
*.mkv
*.m4v
*.zip

# System files
.DS_Store
Thumbs.db
EOF